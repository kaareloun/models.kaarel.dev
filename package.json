{
  "name": "models.kaarel.dev",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "build": "vite build && tsc --noEmit && node scripts/patch-server.mjs",
    "start": "node .output/server/index.mjs",
    "fetch": "bun run src/scripts/fetchArtificialAnalysis.ts && bun run src/scripts/fetchZenFree.ts",
    "fetch:aa": "bun run src/scripts/fetchArtificialAnalysis.ts",
    "fetch:zen": "bun run src/scripts/fetchZenFree.ts",
    "watch": "bun run src/scripts/paretoWatch.ts",
    "notify:test": "bun run src/scripts/testNotify.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.121.12",
    "@tanstack/react-start": "^1.121.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.516.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "vite": "^6.3.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bun": "^1.2.16",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
